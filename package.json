{
  "name": "mosaicplan",
  "private": true,
  "version": "1.0.0",
  "description": "MosaicPlan – Fotos in maßstabsgetreue Glas- und Keramikmosaike mit Stein-für-Stein-Verlegeplan umwandeln",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "e2e": "node e2e/run-e2e.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
